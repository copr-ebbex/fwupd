From 0e8485e386ada4d79f90762e57a7cbafeb80fddc Mon Sep 17 00:00:00 2001
From: Erik Berg <fwupd@slipsprogrammor.no>
Date: Thu, 17 Sep 2026 01:24:17 +0200
Subject: [PATCH 21/21] genesys: Add an emulation test for the HP Z27k G3

Records the enumeration of both cascaded hubs and the scaler behind
them, and asserts the scaler's GUID and reported firmware ID.

The capture covers enumeration only. An install has been recorded on
hardware, but the recording embeds the vendor firmware, which cannot be
redistributed.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 plugins/genesys/meson.build                 |   3 +
 plugins/genesys/tests/hp-z27k-g3-setup.json | 653 ++++++++++++++++++++
 plugins/genesys/tests/hp-z27k-g3.json       |  18 +
 3 files changed, 674 insertions(+)
 create mode 100644 plugins/genesys/tests/hp-z27k-g3-setup.json
 create mode 100644 plugins/genesys/tests/hp-z27k-g3.json

diff --git a/plugins/genesys/meson.build b/plugins/genesys/meson.build
index 5b47b4099..4d7a5489e 100644
--- a/plugins/genesys/meson.build
+++ b/plugins/genesys/meson.build
@@ -35,8 +35,11 @@ device_tests += files(
   #  'tests/genesys-evb-failure.json', # cannot emulate two devices(usb hub + child hid).
   'tests/genesys-servo-dock.json',
   'tests/genesys-zdn-chromebook.json',
+  'tests/hp-z27k-g3.json',
 )
 
+enumeration_data += files('tests/hp-z27k-g3-setup.json')
+
 if get_option('tests')
   install_data(
     ['tests/genesys-mstar-scaler.builder.xml'],
diff --git a/plugins/genesys/tests/hp-z27k-g3-setup.json b/plugins/genesys/tests/hp-z27k-g3-setup.json
new file mode 100644
