From 4e847727a5275a85bee34f7785f1f264d3bca17c Mon Sep 17 00:00:00 2001
From: Erik Berg <fwupd@slipsprogrammor.no>
Date: Thu, 17 Sep 2026 01:09:13 +0200
Subject: [PATCH 11/21] genesys: Use the hub proxy for the outgoing DDC/CI
 control transfer

FuGenesysScalerDevice derives from FuDevice, not FuUsbDevice, so the
HOST_TO_DEVICE transfer failed the FU_IS_USB_DEVICE() precondition and
returned FALSE without setting the GError. The caller then called
g_prefix_error_literal() on an unset error, and probe() failed with no
message on the HP M24fd and M27fd.

The DEVICE_TO_HOST transfer a few lines below already used the proxy.
This call site was missed in dafea2350, first released in 2.0.0.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 plugins/genesys/fu-genesys-scaler-device.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/plugins/genesys/fu-genesys-scaler-device.c b/plugins/genesys/fu-genesys-scaler-device.c
index 03e232143..a26ffdde2 100644
--- a/plugins/genesys/fu-genesys-scaler-device.c
+++ b/plugins/genesys/fu-genesys-scaler-device.c
@@ -1485,7 +1485,11 @@ fu_genesys_scaler_device_get_ddcci_data(FuGenesysScalerDevice *self,
 	data[5] = cmd;
 	data[6] = fu_xor8(data, sizeof(data) - 1);
 
-	if (!fu_usb_device_control_transfer(FU_USB_DEVICE(self),
+	/* the DDC/CI frame is bridged by the USB hub */
+	proxy = fu_device_get_proxy(FU_DEVICE(self), error);
+	if (proxy == NULL)
+		return FALSE;
+	if (!fu_usb_device_control_transfer(FU_USB_DEVICE(proxy),
 					    FU_USB_DIRECTION_HOST_TO_DEVICE,
 					    FU_USB_REQUEST_TYPE_VENDOR,
 					    FU_USB_RECIPIENT_DEVICE,
@@ -1504,9 +1508,6 @@ fu_genesys_scaler_device_get_ddcci_data(FuGenesysScalerDevice *self,
 
 	fu_device_sleep(FU_DEVICE(self), 100); /* 1ms */
 
-	proxy = fu_device_get_proxy(FU_DEVICE(self), error);
-	if (proxy == NULL)
-		return FALSE;
 	if (!fu_usb_device_control_transfer(FU_USB_DEVICE(proxy),
 					    FU_USB_DIRECTION_DEVICE_TO_HOST,
 					    FU_USB_REQUEST_TYPE_VENDOR,
-- 
2.55.0

